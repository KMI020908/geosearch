# Raw GeoNames dumps: where `make download` puts them and `make etl` reads them.
GEONAMES_DATA_DIR=data/raw

# The staging corpus `make etl` writes and `make artifacts` reads. Intermediate
# and git-ignored — reproducible from the raw dumps, and what gets published is
# the compiled artifact built from it, not this.
CORPUS_DIR=data/corpus

# What serving actually reads. Built by `make artifacts`, or fetched with
# `make hub-pull`. Nothing on the request path touches anything else.
ARTIFACTS_DIR=data/artifacts

# NER serving. The default is the fine-tuned checkpoint `make ner-train` writes.
# NER_CJK_SPLITTER must stay true for it (it was trained on that tokenization)
# and be set to false if GLINER_MODEL points at a zero-shot hub checkpoint —
# a mismatch degrades Chinese silently, so the engine reads ner_meta.json beside
# the weights and refuses to start on one.
# NER_THRESHOLD is a serving parameter, not a property of the model: retrieval is
# recall-hungry, so it sits below GLiNER's own 0.5. Re-derive it from the sweep
# in `make ner-eval` whenever the model changes.
GLINER_MODEL=data/gliner-geosearch
NER_CJK_SPLITTER=true
NER_THRESHOLD=0.4

# Synthetic query-dataset generation (src/dataset/generate.py)
DEEPSEEK_API_KEY=

# HuggingFace Hub. A *write* token is needed to publish (`make hub-push-*`); a
# read token, or none at all, is enough to pull public artifacts. Never put a
# real value here — this file is committed. Put it in .env, which is gitignored.
HF_TOKEN=

# Which Hub repos to publish to and pull from. Defaults are in src/config.py
# (HfConfig); override any one of them without touching the rest.
# HF__NER_REPO=mki0809/geosearch-ner
# HF__RERANKER_REPO=mki0809/geosearch-reranker
# HF__INDEX_REPO=mki0809/geosearch-index
# HF__DATASETS_REPO=mki0809/geosearch-queries
#
# Which commit to pull. "main" tracks the latest; a 40-char sha freezes a run,
# which is what a number reported in the thesis needs. Every pull logs the sha
# it resolved to and every push prints the sha to pin.
# HF__INDEX_REVISION=main
# HF__NER_REVISION=main
# HF__RERANKER_REVISION=main
