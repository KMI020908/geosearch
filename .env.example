POSTGRES_USER=geosearch
POSTGRES_PASSWORD=geosearch
POSTGRES_DB=geosearch
GEONAMES_DATA_DIR=data/raw

# BM25 index: where it's stored, and whether to load it from disk instead of
# rebuilding from the DB. Set to true once the .pkl exists; delete the .pkl (or
# flip back to false) after changing the corpus so it rebuilds.
INDEX_PATH=data/bm25_index.pkl
INDEX_WARM_START=false

# Synthetic query-dataset generation (src/dataset/generate.py)
DEEPSEEK_API_KEY=